{% macro icon(name, class='icon') %}
<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor"
     stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="{{ class }}"
     aria-hidden="true" data-icon="{{ name }}">{{ ICONS[name] | safe }}</svg>
{% endmacro %}

{# Hidden sprite so client-rendered views (statistics, tables) can reuse the
   same glyphs with <use href="#icon-name"> without duplicating path data. #}
{% macro sprite() %}
<svg xmlns="http://www.w3.org/2000/svg" class="icon-sprite" aria-hidden="true" focusable="false">
  {% for name, body in ICONS.items() %}
  <symbol id="icon-{{ name }}" viewBox="0 0 24 24" fill="none" stroke="currentColor"
          stroke-width="2" stroke-linecap="round" stroke-linejoin="round">{{ body | safe }}</symbol>
  {% endfor %}
</svg>
{% endmacro %}
